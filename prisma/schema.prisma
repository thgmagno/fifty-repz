generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TrainingMode {
  // seguir o plano oficial Fifty Repz
  PROGRAM
  // montar os próprios treinos
  SOLO
}

model User {
  id String @id @default(uuid())
  googleId String @unique
  email String @unique
  name String?
  image String?
  username String @unique
  bio String?
  // preenchidos no onboarding do primeiro acesso; onboardedAt null = o
  // usuário ainda não passou pela tela de boas-vindas. trainingMode fica
  // null quando ele escolhe decidir depois.
  trainingMode TrainingMode?
  onboardedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  exercises Exercise[]
  workoutPrograms WorkoutProgram[]
  workoutTemplates WorkoutTemplate[]
  workoutSessions WorkoutSession[]
  // edges onde este usuário é o follower (quem ele segue)
  following Follow[] @relation("UserFollows")
  // edges onde este usuário é o seguido (quem o segue)
  followers Follow[] @relation("UserFollowedBy")
  likes Like[]
  comments Comment[]
}

model Follow {
  id String @id @default(uuid())
  follower User @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  followerId String
  following User @relation("UserFollowedBy", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String
  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

enum MuscleGroup {
  ABDOMINALS
  ABDUCTORS
  ADDUCTORS
  BICEPS
  CALVES
  CHEST
  FOREARMS
  GLUTES
  HAMSTRINGS
  LATS
  LOWER_BACK
  MIDDLE_BACK
  NECK
  QUADRICEPS
  SHOULDERS
  TRAPS
  TRICEPS
}

enum Equipment {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
  EZ_BAR
  BANDS
  MEDICINE_BALL
  EXERCISE_BALL
  OTHER
}

model Exercise {
  id String @id @default(uuid())
  slug String @unique
  name String
  nameEn String?
  muscleGroup MuscleGroup
  secondaryMuscles MuscleGroup[]
  equipment Equipment
  imageUrls String[]
  instructions String[] @default([])
  isCustom Boolean @default(false)
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  templateEntries WorkoutTemplateExercise[]
  sessionEntries WorkoutSessionExercise[]

  @@index([muscleGroup])
  @@index([ownerId])
}

// Todo treino pertence a um plano: os oficiais pelo nível do plano oficial
// (programLevelId), os do usuário direto pelo plano dele (programId).
model WorkoutTemplate {
  id String @id @default(uuid())
  name String
  // ownerId null = treino oficial de um WorkoutProgramLevel
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String?
  // plano do usuário ao qual o treino pertence; null nos treinos oficiais,
  // que chegam ao plano pelo nível
  program WorkoutProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId String?
  // treino oficial pertence a um nível de programa; null para templates de usuário
  programLevel WorkoutProgramLevel? @relation(fields: [programLevelId], references: [id], onDelete: Cascade)
  programLevelId String?
  // ordem do treino dentro do nível (A=0, B=1, ...); null para templates de usuário
  planOrder Int?
  exercises WorkoutTemplateExercise[]
  sessions WorkoutSession[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([programId])
  @@index([programLevelId])
}

// Plano de treino: oficial (ownerId null, com níveis e slug do seed) ou
// criado pelo usuário (ownerId preenchido, com treinos diretos)
model WorkoutProgram {
  id String @id @default(uuid())
  // só os planos oficiais têm slug (chave estável do seed)
  slug String? @unique
  name String
  description String?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String?
  levels WorkoutProgramLevel[]
  templates WorkoutTemplate[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model WorkoutProgramLevel {
  id String @id @default(uuid())
  program WorkoutProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId String
  // 1..N, sequência de desbloqueio dentro do programa
  level Int
  name String
  description String?
  // quantas conclusões (de qualquer treino deste nível) liberam o próximo nível
  unlockThreshold Int @default(50)
  templates WorkoutTemplate[]

  @@unique([programId, level])
  @@index([programId])
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
}

model WorkoutSession {
  id String @id @default(uuid())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  // template pode ser excluído/renomeado depois: a sessão guarda snapshot
  template WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId String?
  templateName String
  status WorkoutSessionStatus @default(IN_PROGRESS)
  startedAt DateTime @default(now())
  completedAt DateTime?
  durationSeconds Int?
  exercises WorkoutSessionExercise[]
  likes Like[]
  comments Comment[]

  @@index([userId, status])
  @@index([templateId])
}

model Like {
  id String @id @default(uuid())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  createdAt DateTime @default(now())

  @@unique([userId, sessionId])
  @@index([sessionId])
}

model Comment {
  id String @id @default(uuid())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  body String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model WorkoutSessionExercise {
  id String @id @default(uuid())
  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  // snapshot do exercício e das metas no momento em que a sessão começou
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  exerciseId String?
  exerciseName String
  position Int
  targetSets Int
  targetReps Int
  targetRepsMax Int?
  skipped Boolean @default(false)
  sets SessionSet[]

  @@index([sessionId])
}

model SessionSet {
  id String @id @default(uuid())
  sessionExercise WorkoutSessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  sessionExerciseId String
  setNumber Int
  weightKg Float?
  reps Int
  completedAt DateTime @default(now())

  @@index([sessionExerciseId])
}

model WorkoutTemplateExercise {
  id String @id @default(uuid())
  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseId String
  position Int
  targetSets Int
  // faixa de reps alvo: targetReps é o mínimo; máximo opcional (ex.: 8-12)
  targetReps Int
  targetRepsMax Int?

  @@index([templateId])
  @@index([exerciseId])
}
